# FairShare Environment Variables Template
# Copy this file to server/.env and fill in your MySQL credentials

PORT=5000
NODE_ENV=development

# MySQL Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fairshare_db

# Security & Auth
JWT_SECRET=replace_with_a_secure_random_key
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
